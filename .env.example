# 基础配置
APP_ENV=production
APP_NAME=WeCom AI Gateway
PUBLIC_BASE_URL=https://example.com
DATABASE_URL=postgresql+psycopg://wecom:change-me@postgres:5432/wecom_ai
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=replace-with-a-long-random-token
IDENTITY_HMAC_KEY=replace-with-32-or-more-random-characters
SECRET_ENCRYPTION_KEY=replace-with-a-fernet-key

# 企业微信客服
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_SECRET=replace-me
WECOM_CALLBACK_TOKEN=letters-and-digits-only
WECOM_ENCODING_AES_KEY=43-character-key
WECOM_OPEN_KFID=wkxxxxxxxxxxxxxxxx
WECOM_CALLBACK_PATH=/wecom/kf/callback

# 平台默认模型（OpenAI 兼容接口）
DEFAULT_PROVIDER=openai-compatible
DEFAULT_MODEL=deepseek-chat
DEFAULT_SYSTEM_PROMPT=你是一个准确、友善且尊重隐私的人工智能助手。
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPATIBLE_API_KEY=
REQUEST_TIMEOUT_SECONDS=90
USER_DAILY_TOKEN_QUOTA=100000
UNCONFIGURED_MODEL_MESSAGE=模型服务正在配置中。命令功能仍可使用，发送 /help 查看可用设置。

# 可靠任务与 Worker
WORKER_POLL_SECONDS=2
TASK_MAX_ATTEMPTS=5
TASK_RETRY_BASE_SECONDS=5
TASK_RETRY_MAX_SECONDS=300
TASK_LOCK_TIMEOUT_SECONDS=300
SYNC_LOCK_SECONDS=120

# 运行模式（v0.3.0）
# 平台默认模式：self_service（用户自足）| managed（统一管理）
PLATFORM_MODE=self_service
# 全局单用户开关：true 时忽略平台/用户模式，一切指令放行（手动开启，不做自动检测）
SINGLE_USER_MODE=false
